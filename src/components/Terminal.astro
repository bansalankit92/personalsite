---
import { profile, stats } from '../data/profile';

const chips = [
  { href: '#featured', label: 'featured/' },
  { href: '#experience', label: 'experience/' },
  { href: '#skills', label: 'skills/' },
  { href: '#projects', label: 'projects/' },
  { href: '#services', label: 'services/' },
];
---

<section id="top" class="hero" aria-label="Introduction">
  <div class="container">
    <div class="term card" data-terminal>
      <div class="term-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="term-title">ankit@bansal: ~</span>
        <button type="button" class="skip" data-skip hidden>skip ⏭</button>
      </div>

      <div class="term-body">
        <p class="line" data-cmd><span class="ps">$</span><span class="typed">whoami</span></p>
        <div class="out" data-out>
          <h1 class="name">{profile.name}</h1>
          <p class="role">
            <span>{profile.role}</span><span class="sep">·</span><span
              data-years="career"
              data-suffix=" yrs">11 yrs</span
            ><span class="sep">·</span><span>Pune, India</span>
          </p>
        </div>

        <p class="line" data-cmd><span class="ps">$</span><span class="typed">cat stack.txt</span></p>
        <p class="out stack" data-out>
          {
            profile.stack.map((s, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                <span>{s}</span>
              </>
            ))
          }
        </p>

        <p class="line" data-cmd><span class="ps">$</span><span class="typed">cat tagline.txt</span></p>
        <p class="out muted" data-out>{profile.tagline}</p>

        <p class="line" data-cmd><span class="ps">$</span><span class="typed">ls</span></p>
        <ul class="out chips" data-out>
          {
            chips.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))
          }
          <li><a href={profile.resume} download class="file">resume.pdf</a></li>
        </ul>

        <p class="line" data-cmd>
          <span class="ps">$</span><span class="typed">echo "I am $USER"</span>
        </p>
        <p class="out" data-out>
          I am <span class="rotate" data-rotate={JSON.stringify(profile.typedStrings)}
            >{profile.typedStrings[profile.typedStrings.length - 1]}</span
          ><span class="caret" aria-hidden="true"></span>
        </p>
      </div>
    </div>

    <div class="cta reveal">
      <a class="btn btn-primary" href={profile.resume} download>↓ Download Resume</a>
      <a class="btn" href={`mailto:${profile.email}`}>Hire me</a>
    </div>

    <dl class="stats reveal">
      {
        stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>
              {s.dynamic === 'career' ? (
                <span data-years="career" data-suffix="+">
                  {s.value}
                </span>
              ) : (
                s.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: 32px 56px;
  }
  @media (min-width: 768px) {
    .hero {
      padding-block: 64px 88px;
    }
  }
  .term {
    overflow: hidden;
    background: var(--bg-sunken);
    max-width: 880px;
    margin-inline: auto;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-raised);
    position: relative;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dots i:nth-child(2) {
    background: #febc2e;
  }
  .dots i:nth-child(3) {
    background: #28c840;
  }
  .term-title {
    flex: 1;
    text-align: center;
    font: 0.8125rem var(--font-mono);
    color: var(--muted);
    margin-right: 54px; /* balance the dots so the title is centred */
  }
  .skip {
    position: absolute;
    right: 14px;
    font: 0.75rem var(--font-mono);
    color: var(--muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px 8px;
    cursor: pointer;
  }
  .term-body {
    padding: 20px 16px 24px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  @media (min-width: 640px) {
    .term-body {
      padding: 28px 32px 32px;
      font-size: 0.9375rem;
    }
  }
  .line {
    color: var(--text);
    margin-top: 14px;
  }
  .line:first-child {
    margin-top: 0;
  }
  .ps {
    color: var(--accent);
    margin-right: 1ch;
    user-select: none;
  }
  .out {
    color: var(--muted);
  }
  .name {
    font-family: var(--font-sans);
    font-size: clamp(2.25rem, 8vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 6px 0 4px;
    line-height: 1.05;
  }
  .role {
    color: var(--text);
  }
  .sep {
    color: var(--faint);
    margin-inline: 0.6ch;
  }
  .stack span:not(.sep) {
    color: var(--blue);
    white-space: nowrap;
  }
  .role span:not(.sep) {
    white-space: nowrap;
  }
  .role,
  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .muted {
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin-top: 6px;
  }
  .chips a {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--blue);
    text-decoration: none;
    min-height: 36px;
  }
  .chips a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .chips a.file {
    color: var(--amber);
  }
  .rotate {
    color: var(--accent);
    font-weight: 700;
  }
  .caret {
    display: inline-block;
    width: 0.6ch;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* While typing: pending lines keep their space so nothing jumps */
  .typing .pending {
    visibility: hidden;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    max-width: 880px;
    margin: 28px auto 0;
  }
  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  .stat dd {
    margin: 0;
    font: 700 clamp(1.5rem, 4vw, 2rem) / 1.1 var(--font-mono);
    color: var(--accent);
  }
  .stat dt {
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>

<script>
  const term = document.querySelector<HTMLElement>('[data-terminal]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function rotate(el: HTMLElement, instant: boolean) {
    const words: string[] = JSON.parse(el.dataset.rotate || '[]');
    if (instant || words.length < 2) return;
    (async () => {
      for (const word of words) {
        el.textContent = '';
        for (const ch of word) {
          el.textContent += ch;
          await sleep(55);
        }
        if (word !== words[words.length - 1]) {
          await sleep(1000);
          while (el.textContent) {
            el.textContent = el.textContent.slice(0, -1);
            await sleep(30);
          }
        }
      }
    })();
  }

  if (term) {
    const rotator = term.querySelector<HTMLElement>('[data-rotate]');
    const steps = [...term.querySelectorAll<HTMLElement>('[data-cmd], [data-out]')];
    const skipBtn = term.querySelector<HTMLButtonElement>('[data-skip]');
    let skipped = false;

    const finish = () => {
      skipped = true;
      term.classList.remove('typing');
      steps.forEach((s) => {
        s.classList.remove('pending');
        const t = s.querySelector<HTMLElement>('.typed');
        if (t?.dataset.full) t.textContent = t.dataset.full;
      });
      if (skipBtn) skipBtn.hidden = true;
    };

    if (reduce) {
      rotate(rotator!, true);
    } else {
      term.classList.add('typing');
      steps.forEach((s) => {
        s.classList.add('pending');
        const t = s.querySelector<HTMLElement>('.typed');
        if (t) {
          t.dataset.full = t.textContent || '';
          t.textContent = '';
        }
      });
      if (skipBtn) {
        skipBtn.hidden = false;
        skipBtn.addEventListener('click', finish);
      }

      (async () => {
        await sleep(120);
        for (const step of steps) {
          if (skipped) return;
          step.classList.remove('pending');
          const t = step.querySelector<HTMLElement>('.typed');
          if (t) {
            for (const ch of t.dataset.full || '') {
              if (skipped) return;
              t.textContent += ch;
              await sleep(22 + Math.random() * 22);
            }
            await sleep(160);
          } else {
            await sleep(90);
          }
        }
        finish();
        rotate(rotator!, false);
      })();
    }
  }
</script>
