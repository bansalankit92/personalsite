---
import SectionHeader from './SectionHeader.astro';
import { profile } from '../data/profile';
import { getContributions } from '../data/github';

const data = await getContributions(profile.githubUser);

const cell = 11;
const gap = 3;
const step = cell + gap;
const top = 18; // room for month labels
const left = 28; // room for weekday labels
const width = data ? left + data.weeks * step : 0;
const height = top + 7 * step;

const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<section id="github" class="section" aria-labelledby="github-title">
  <div class="container">
    <SectionHeader cmd={`git log --graph --author=${profile.githubUser}`} title="GitHub Activity" id="github-title" />

    <div class="panel card reveal">
      <div class="head">
        <p class="summary">
          {
            data ? (
              <>
                <strong>{data.total.toLocaleString('en-IN')}</strong> contributions in the last year
              </>
            ) : (
              <>Open source and side projects on GitHub</>
            )
          }
        </p>
        <a class="btn" href={profile.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
            ></path></svg
          >
          github.com/{profile.githubUser} ↗
        </a>
      </div>

      {
        data && (
          <>
            <div class="scroll" data-gh-scroll>
              <a
                href={profile.github}
                target="_blank"
                rel="noopener"
                class="graph-link"
                aria-label={`${data.total} GitHub contributions in the last year. Open GitHub profile.`}
              >
                <svg class="graph" viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-hidden="true">
                  {data.months.map((m) => (
                    <text x={left + m.week * step} y="11" class="lbl">
                      {m.label}
                    </text>
                  ))}
                  <text x="0" y={top + 1 * step + 9} class="lbl">
                    Mon
                  </text>
                  <text x="0" y={top + 3 * step + 9} class="lbl">
                    Wed
                  </text>
                  <text x="0" y={top + 5 * step + 9} class="lbl">
                    Fri
                  </text>
                  {data.days.map((d) => (
                    <rect
                      x={left + d.week * step}
                      y={top + d.weekday * step}
                      width={cell}
                      height={cell}
                      rx="2.5"
                      class={`l${d.level}`}
                    >
                      <title>{`${d.count === 0 ? 'No' : d.count} contribution${d.count === 1 ? '' : 's'} on ${fmt(d.date)}`}</title>
                    </rect>
                  ))}
                </svg>
              </a>
            </div>
            <div class="legend" aria-hidden="true">
              <span>Less</span>
              {[0, 1, 2, 3, 4].map((l) => (
                <svg width="11" height="11" viewBox="0 0 11 11">
                  <rect width="11" height="11" rx="2.5" class={`l${l}`} />
                </svg>
              ))}
              <span>More</span>
            </div>
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  .panel {
    padding: 20px;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .panel {
      padding: 24px 28px;
    }
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .summary {
    color: var(--muted);
  }
  .summary strong {
    font: 700 1.5rem var(--font-mono);
    color: var(--accent);
    margin-right: 6px;
  }
  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 4px;
  }
  .graph-link {
    display: block;
  }
  .graph {
    display: block;
    width: 100%;
    min-width: 680px;
    height: auto;
  }
  .lbl {
    font: 9px var(--font-mono);
    fill: var(--faint);
  }
  .l0 {
    fill: var(--bg-sunken);
    stroke: var(--border);
    stroke-width: 1;
  }
  .l1 {
    fill: color-mix(in srgb, var(--accent) 30%, var(--bg-raised));
  }
  .l2 {
    fill: color-mix(in srgb, var(--accent) 55%, var(--bg-raised));
  }
  .l3 {
    fill: color-mix(in srgb, var(--accent) 78%, var(--bg-raised));
  }
  .l4 {
    fill: var(--accent);
  }
  rect:hover {
    stroke: var(--text);
    stroke-width: 1;
  }
  .legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font: 0.75rem var(--font-mono);
    color: var(--faint);
  }
  .legend span:first-child {
    margin-right: 4px;
  }
  .legend span:last-child {
    margin-left: 4px;
  }
</style>

<script>
  // On narrow screens start the graph at the most recent weeks.
  document.querySelectorAll<HTMLElement>('[data-gh-scroll]').forEach((el) => {
    el.scrollLeft = el.scrollWidth;
  });
</script>
