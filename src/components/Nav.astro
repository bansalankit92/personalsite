---
import { profile } from '../data/profile';

const links = [
  { href: '#about', label: 'about' },
  { href: '#featured', label: 'featured' },
  { href: '#experience', label: 'experience' },
  { href: '#skills', label: 'skills' },
  { href: '#projects', label: 'projects' },
  { href: '#services', label: 'services' },
];
---

<header class="nav" data-nav-root>
  <div class="container nav-inner">
    <a class="brand" href="#top" aria-label="Ankit Bansal, back to top">
      <span class="ps">~/</span>ankit<span class="cursor" aria-hidden="true">_</span>
    </a>

    <nav aria-label="Sections" class="links">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-nav>
                <span class="tilde">~/</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle light and dark theme">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path></svg
        >
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"></path></svg
        >
      </button>
      <a class="btn btn-primary hire" href={`mailto:${profile.email}`} data-hire>Hire me</a>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-btn
      >
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="sheet" data-menu hidden>
    <nav aria-label="Sections (mobile)" class="container">
      <p class="sheet-cmd" aria-hidden="true"><span class="ps">$</span>cd ~/</p>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-nav data-menu-link>
                <span class="tilde">~/</span>
                {l.label}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="sheet-actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`} data-menu-link data-hire>Hire me</a>
        <a class="btn" href={profile.resume} target="_blank" rel="noopener" data-menu-link>Resume ↗</a>
        <a class="btn book" href={profile.booking} target="_blank" rel="noopener" data-menu-link>Book a 30-min call ↗</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--nav-h);
  }
  .brand {
    font: 700 1rem var(--font-mono);
    color: var(--text);
    text-decoration: none;
    padding-block: 10px;
  }
  .ps {
    color: var(--accent);
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .links ul {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 6px 10px;
    border-radius: 6px;
    font: 0.875rem var(--font-mono);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover,
  .links a.active {
    color: var(--text);
    background: var(--accent-soft);
  }
  .tilde {
    color: var(--faint);
  }
  a:hover .tilde,
  a.active .tilde {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='light']) .sun {
    display: none;
  }
  :global(:root[data-theme='light']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='dark'])) .moon {
      display: block;
    }
  }
  .hire {
    min-height: 44px;
    padding: 8px 16px;
  }

  /* Hamburger -> X */
  .menu-btn {
    display: none;
  }
  .burger {
    position: relative;
    width: 18px;
    height: 14px;
  }
  .burger i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease, top 0.2s ease;
  }
  .burger i:nth-child(1) {
    top: 0;
  }
  .burger i:nth-child(2) {
    top: 6px;
  }
  .burger i:nth-child(3) {
    top: 12px;
  }
  [aria-expanded='true'] .burger i:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .burger i:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded='true'] .burger i:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  /* Mobile sheet */
  .sheet {
    border-top: 1px solid var(--border);
    background: var(--bg);
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    padding-block: 16px 24px;
    animation: drop 0.18s ease-out;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .sheet-cmd {
    font: 0.8125rem var(--font-mono);
    color: var(--muted);
    margin-bottom: 8px;
  }
  .sheet-cmd .ps {
    margin-right: 1ch;
  }
  .sheet ul {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .sheet li + li {
    border-top: 1px dashed var(--border);
  }
  .sheet a[data-nav] {
    display: flex;
    align-items: center;
    min-height: 52px;
    font: 600 1.125rem var(--font-mono);
    color: var(--text);
    text-decoration: none;
  }
  .sheet a[data-nav].active {
    color: var(--accent);
  }
  .arrow {
    margin-left: auto;
    color: var(--faint);
  }
  .sheet-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 20px;
  }
  .sheet-actions .book {
    grid-column: 1 / -1;
  }

  @media (max-width: 859px) {
    .links,
    .hire {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (min-width: 860px) {
    .sheet {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;

  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current =
      root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    const next = current === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Mobile menu
  const header = document.querySelector<HTMLElement>('[data-nav-root]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    if (!menuBtn || !menu) return;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuBtn?.addEventListener('click', () => setOpen(menu!.hidden));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      menuBtn?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (menu && !menu.hidden && header && !header.contains(e.target as Node)) setOpen(false);
  });
  window.matchMedia('(min-width: 860px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Highlight the section currently in view
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-nav]')];
  const sections = [...new Set(navLinks.map((a) => a.getAttribute('href')!))]
    .map((h) => document.querySelector<HTMLElement>(h))
    .filter((el): el is HTMLElement => !!el);
  let ticking = false;
  const updateActive = () => {
    ticking = false;
    const line = window.scrollY + window.innerHeight * 0.4;
    let current: HTMLElement | undefined;
    for (const s of sections) if (s.offsetTop <= line) current = s;
    navLinks.forEach((a) => a.classList.toggle('active', !!current && a.getAttribute('href') === `#${current.id}`));
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    },
    { passive: true },
  );
  updateActive();
</script>
