const pngs: Record<string, ImageMetadata> = { hackerrank, hackerearth };
const { center = false } = Astro.props as { center?: boolean };
---

<ul class:list={['social', { center }]} aria-label="Social profiles">
  {
    socials.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener me" aria-label={s.name} title={s.name}>
          {pngs[s.icon] ? (
            <Image src={pngs[s.icon]} alt="" width={20} height={22} />
          ) : (
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d={paths[s.icon]} fill="currentColor" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
  }
  .social.center {
    justify-content: center;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--muted);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .social a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .social img {
    width: 20px;
    height: auto;
    filter: grayscale(1);
    opacity: 0.8;
  }
  .social a:hover img {
    filter: none;
    opacity: 1;
  }
</style>
