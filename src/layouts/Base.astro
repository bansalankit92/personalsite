---
import '../styles/global.css';
import { site, profile, socials, featured, skills, education } from '../data/profile';

// Every prop is optional: the home page uses the defaults, other pages pass their own SEO.
interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  keywords?: string;
  path?: string; // e.g. '/pustak-scan', used for the canonical and og:url
  ogType?: string;
  image?: { url: string; width: number; height: number; alt: string };
  largeImage?: boolean; // twitter:card summary_large_image
  jsonLd?: Record<string, unknown>; // replaces the home page's structured data
  noindex?: boolean; // keep a page out of search results (e.g. the blog before its first post)
}
const props = Astro.props;

const url = `${site.url}/`;
const image = `${site.url}/jpg/ankit.png`;
const personId = `${url}#person`;

const pageTitle = props.title ?? site.title;
const pageDescription = props.description ?? site.description;
const pageOgDescription = props.ogDescription ?? props.description ?? site.ogDescription;
const pageKeywords = props.keywords ?? site.keywords;
const pageUrl = props.path ? `${site.url}${props.path}` : url;
const ogImage = props.image ?? { url: image, width: 782, height: 661, alt: 'Ankit Bansal, Senior Software Engineer' };
const isHome = !props.path;

// Structured data for search engines (schema.org), generated from the same content as the page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${url}#website`,
      url,
      name: 'Ankit Bansal',
      inLanguage: 'en-IN',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${url}#profilepage`,
      url,
      name: site.title,
      description: site.description,
      inLanguage: 'en-IN',
      isPartOf: { '@id': `${url}#website` },
      mainEntity: { '@id': personId },
      dateModified: new Date().toISOString().slice(0, 10),
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      givenName: 'Ankit',
      familyName: 'Bansal',
      jobTitle: profile.role,
      description: site.description,
      url,
      image,
      email: `mailto:${profile.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Pune',
        addressRegion: 'Maharashtra',
        postalCode: '412101',
        addressCountry: 'IN',
      },
      alumniOf: { '@type': 'CollegeOrUniversity', name: education[0].place },
      knowsAbout: skills.flatMap((g) => g.subgroups.flatMap((sg) => sg.skills.map((sk) => sk.name))),
      sameAs: socials.map((s) => s.href),
    },
    ...featured
      .filter((f) => f.relation === 'Founder')
      .map((f) => {
        // An app with its own page here uses that page's @id, so both graphs describe one entity.
        const page = f.links?.find((l) => l.href.startsWith('/'))?.href;
        return f.kind === 'app'
          ? {
              '@type': 'MobileApplication',
              '@id': page ? `${site.url}${page}#app` : `${url}#${f.id}`,
              name: f.name,
              url: page ? `${site.url}${page}` : f.url,
              installUrl: f.url,
              description: f.description,
              operatingSystem: 'Android',
              applicationCategory: 'ProductivityApplication',
              author: { '@id': personId },
              creator: { '@id': personId },
            }
          : {
              '@type': 'Organization',
              '@id': `${f.url}/#organization`,
              name: f.name,
              url: f.url,
              description: f.description,
              founder: { '@id': personId },
            };
      }),
  ],
};
const jsonLdHtml = JSON.stringify(props.jsonLd ?? jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="author" content="Ankit Bansal" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="robots" content={props.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="google-site-verification" content={site.googleSiteVerification} />
    <meta name="theme-color" content="#0b0e14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f8fa" media="(prefers-color-scheme: light)" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary" />
    <link rel="alternate" type="application/rss+xml" href="/blog/rss.xml" title="Ankit Bansal's blog" />
    <link rel="me" href="https://github.com/bansalankit92" />
    <link rel="me" href="https://www.linkedin.com/in/ankitbansal2/" />

    <!-- Open Graph -->
    <meta property="og:type" content={props.ogType ?? 'profile'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageOgDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Ankit Bansal" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    {
      isHome && (
        <>
          <meta property="profile:first_name" content="Ankit" />
          <meta property="profile:last_name" content="Bansal" />
        </>
      )
    }

    <!-- X / Twitter -->
    <meta name="twitter:card" content={props.largeImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@ankeetbansal" />
    <meta name="twitter:creator" content="@ankeetbansal" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageOgDescription} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <script type="application/ld+json" set:html={jsonLdHtml} />

    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <!-- Google Tag Manager, loaded once the page is idle so it never delays first paint -->
    <script is:inline define:vars={{ gtmId: site.gtmId }}>
      (function (w, d) {
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        function load() {
          var j = d.createElement('script');
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
          d.head.appendChild(j);
        }
        function idle() {
          'requestIdleCallback' in w ? w.requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1500);
        }
        d.readyState === 'complete' ? idle() : w.addEventListener('load', idle);
      })(window, document);
    </script>
  </head>
  <body>
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe
      ></noscript
    >
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 100;
    padding: 8px 12px;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: 6px;
    font: 600 0.875rem var(--font-mono);
  }
  .skip-link:focus {
    top: 12px;
  }
</style>
