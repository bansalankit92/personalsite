---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Terminal from '../components/Terminal.astro';
import About from '../components/About.astro';
import Featured from '../components/Featured.astro';
import GitHub from '../components/GitHub.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';
import HireDialog from '../components/HireDialog.astro';
import { profile } from '../data/profile';
---

<Base>
  <Nav />
  <main id="main">
    <Terminal />
    <About />
    <Featured />
    <GitHub />
    <Experience />
    <Skills />
    <Projects />
    <Services />
  </main>
  <Footer />
  <HireDialog />
</Base>

<script define:vars={{ birthDate: profile.birthDate, careerStart: profile.careerStart }}>
  // Age and career length stay current without a rebuild (same formulas as the 2016 site).
  var YEAR_MS = 3.15576e10;
  var now = Date.now();
  var values = {
    age: String(Math.floor((now - new Date(birthDate).getTime()) / YEAR_MS)),
    career: String(Math.floor((now - new Date(careerStart).getTime()) / YEAR_MS)),
    'career-precise': ((now - new Date(careerStart).getTime()) / YEAR_MS).toFixed(1),
  };
  document.querySelectorAll('[data-years]').forEach(function (el) {
    var v = values[el.getAttribute('data-years')];
    if (v) el.textContent = v + (el.getAttribute('data-suffix') || '');
  });

  // Fade sections in as they scroll into view.
  var items = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach(function (el) {
      io.observe(el);
    });
  } else {
    items.forEach(function (el) {
      el.classList.add('is-visible');
    });
  }
</script>
